# Environment variables for Agentbox → Register an agent → Env Variables.
# Everything here is optional. With MaaS integration ON, GMI injects GMI_MAAS_API_KEY and
# GMI_MAAS_BASE_URL automatically. Don't add those two yourself.

# Text model ID from Model Hub (default: deepseek-ai/DeepSeek-V3.2). A FREE model works too.
TEXT_MODEL=deepseek-ai/DeepSeek-V3.2

# Image model ID from Model Hub for AI artwork (default: seedream-5.0-lite).
# Set to none to offer only the free recap card.
IMAGE_MODEL=seedream-5.0-lite

# How many AI calls run at once. Use 1 with a FREE model, because free endpoints may be rate-limited.
MAX_PARALLEL=3

# Mark as SECRET. Visitors must enter this code before they can use your credits. Leave unset for none.
ACCESS_CODE=

# AI calls one visitor can make per hour on your credits. A full recap uses 7.
MAX_CALLS_PER_HOUR=60

# Let visitors paste their own GMI key, which skips your code and limits and bills their account.
ALLOW_USER_KEYS=true

# Mark as SECRET. Only needed if the recap graphic fails with a key or permission error:
# a normal GMI API key from Settings → API Keys, used for images.
GMI_API_KEY=
